<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:minHeight="600dp">

        <!-- Animated Success Icon -->
        <FrameLayout
            android:id="@+id/frameIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_success_circle"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="48dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_check"
                android:tint="@color/white"
                android:layout_gravity="center"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <!-- Confetti-style accent ring -->
        <View
            android:id="@+id/ringAccent"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_success_ring"
            android:alpha="0.3"
            app:layout_constraintTop_toTopOf="@id/frameIcon"
            app:layout_constraintBottom_toBottomOf="@id/frameIcon"
            app:layout_constraintStart_toStartOf="@id/frameIcon"
            app:layout_constraintEnd_toEndOf="@id/frameIcon" />

        <TextView
            android:id="@+id/tvBookedTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Booking Confirmed!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textAlignment="center"
            android:gravity="center"
            android:layout_marginTop="28dp"
            app:layout_constraintTop_toBottomOf="@id/frameIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvBookedSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Thank you for your reservation! We\'ve received your booking request and the business owner will review it shortly."
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:textAlignment="center"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvBookedTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Info Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0FAF5"
            app:layout_constraintTop_toBottomOf="@id/tvBookedSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvBookingDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_pin"
                        android:tint="@color/primary" />

                    <TextView
                        android:id="@+id/tvBookingPlace"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvStatusNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Your booking status will appear as Pending until confirmed by the business."
            android:drawableStart="@drawable/ic_clipboard"
            android:drawablePadding="8dp"
            app:drawableTint="@color/pending_text"
            android:textSize="13sp"
            android:textColor="@color/pending_text"
            android:background="@color/pending_bg"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintTop_toBottomOf="@id/cardInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- View Booking Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewBooking"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="View My Booking"
            android:textSize="15sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="28dp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvStatusNote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Back to Explore Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToExplore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Back to Explore"
            android:textSize="15sp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginTop="10dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnViewBooking"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
